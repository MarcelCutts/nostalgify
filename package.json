{
  "name": "nostalgify",
  "productName": "Nostalgify",
  "version": "0.1.0",
  "private": true,
  "description": "Classic Winamp 2 skins for Spotify desktop control and public SoundCloud playback on macOS.",
  "main": "src/main/main.js",
  "homepage": "https://0xchaosbi.github.io/nostalgify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcelCutts/nostalgify.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "soundcloud:check": "node scripts/check-soundcloud.js",
    "build": "esbuild src/renderer/renderer.js --bundle --format=iife --outfile=dist/renderer.js --log-level=warning",
    "start": "npm run build && electron .",
    "package": "sh scripts/package.sh",
    "package:release": "sh scripts/package.sh arm64 && sh scripts/package.sh x64",
    "icon": "python3 scripts/make-icon.py",
    "install-app": "sh scripts/install-app.sh"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "hls.js": "1.7.3",
    "webamp": "^2.3.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}

{
  "name": "nostalgify",
  "productName": "Nostalgify",
  "version": "0.1.0",
  "private": true,
  "description": "Classic Winamp skins for desktop and native iPad music control.",
  "main": "apps/desktop/dist/src/main/main.js",
  "homepage": "https://0xchaosbi.github.io/nostalgify/",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcelCutts/nostalgify.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "npm run build:desktop && npm run build:ipad",
    "build:desktop": "npm run build --workspace=@nostalgify/desktop",
    "build:ipad": "npm run build --workspace=@nostalgify/ipad",
    "start": "npm run build:desktop && electron apps/desktop/dist",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:ipad:browser": "node tests/ipad-smoke.cjs",
    "check": "node scripts/check-build-boundaries.cjs && node scripts/check-ios-project.cjs",
    "ipad:sync": "npm run sync --workspace=@nostalgify/ipad",
    "ipad:open": "npm run open --workspace=@nostalgify/ipad",
    "ipad:simulator": "bash scripts/check-ios-simulator.sh",
    "package": "sh scripts/package.sh",
    "package:release": "sh scripts/package.sh arm64 && sh scripts/package.sh x64",
    "install-app": "sh scripts/install-app.sh",
    "icon": "python3 scripts/make-icon.py",
    "soundcloud:check": "node scripts/check-soundcloud.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
